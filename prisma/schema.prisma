generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  name          String
  role          String         @default("viewer")
  createdAt     DateTime       @default(now())
  receptions    Reception[]
  majorProjects MajorProject[]
}

model Reception {
  id            Int      @id @default(autoincrement())
  startTime     DateTime
  endTime       DateTime
  title         String
  level         String
  form          String
  host          String
  dressCode     String
  purpose       String
  status        String   @default("正常")
  location      String?
  locationKey   String?
  leaders       String?
  minutes       String?
  minuteFiles   String?
  photos        String?
  todos         String?
  remark        String?
  customFields  String?
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  notifications Notification[]
}

// 定时通知
model Notification {
  id           Int       @id @default(autoincrement())
  receptionId  Int
  reception    Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  sent         Boolean   @default(false)
  sentAt       DateTime?
  label        String?
  fields       String?   // JSON: 选中发送的字段
  targetId     Int?
  target       NotifyTarget? @relation(fields: [targetId], references: [id])
  createdAt    DateTime  @default(now())
}

// 通知目标（群机器人或个人）
model NotifyTarget {
  id            Int            @id @default(autoincrement())
  name          String         // 显示名称，如"接待工作群"
  type          String         // group_webhook | person_webhook
  webhook       String         // Webhook URL
  sortOrder     Int            @default(0)
  notifications Notification[]
}

model CustomFieldDef {
  id         Int     @id @default(autoincrement())
  fieldKey   String  @unique
  fieldLabel String
  fieldType  String
  options    String?
  required   Boolean @default(false)
  sortOrder  Int     @default(0)
  enabled    Boolean @default(true)
}

model HostPreset {
  id        Int      @id @default(autoincrement())
  name      String
  title     String?
  feishuId  String?
  avatar    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// 待办大类（含子项）
model TodoCategory {
  id        Int        @id @default(autoincrement())
  name      String
  sortOrder Int        @default(0)
  items     TodoItem[]
}

model TodoItem {
  id         Int          @id @default(autoincrement())
  categoryId Int
  category   TodoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int          @default(0)
}

// 系统配置（key-value）
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MajorProject {
  id              Int            @id @default(autoincrement())
  name            String
  type            String         @default("其他")
  company         String?
  level           String         @default("其他")
  status          String         @default("进行中")
  totalAmount     Float?
  receivedAmount  Float          @default(0)
  owner           String?
  responsible     String?
  applyCode       String?
  star            Boolean        @default(false)
  remark          String?
  customFields    String?
  payRecords      String?
  lifeCycle       String?
  metrics         String?
  parentId        Int?
  parent          MajorProject?  @relation("ProjectChildren", fields: [parentId], references: [id])
  children        MajorProject[] @relation("ProjectChildren")
  createdById     Int
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// 落地协议模块

model AgreementData {
  id          Int      @id @default(autoincrement())
  period      String   // "YYYY-MM"
  category    String   // "finance" | "hr" | "ip"
  payload     String   // JSON: 该月该分类的所有字段
  submittedBy Int?
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([period, category])
}

model QualitativeObligation {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  articleRef   String
  requirement  String
  status       String   @default("pending") // compliant|in_progress|pending|at_risk
  description  String?
  evidenceUrls String?  // JSON array
  updatedById  Int?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model SubsidyApplication {
  id            Int      @id @default(autoincrement())
  code          String
  policyItem    String
  year          Int
  appliedAmount Float?
  submittedAt   DateTime?
  status        String   @default("draft") // draft|submitted|reviewing|approved|paid
  paidAmount    Float?
  paidAt        DateTime?
  remark        String?
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Honor {
  id              Int      @id @default(autoincrement())
  name            String
  level           String   @default("市级") // 市级|省级|国家级|其他
  category        String   @default("其他")  // 先进基层党组织|优秀共产党员|文明单位|高新技术|其他…
  subject         String?  // 获奖主体（公司/党支部等）
  issuedBy        String?  // 颁发单位
  startYear       Int?     // 起始年份（跨年度评定用）
  endYear         Int?     // 结束年份
  awardedAt       DateTime?
  remark          String?
  attachments     String?  // JSON: [{id, name, size, mimeType}]
  feishuRecordId  String?  @unique // 飞书导入去重
  createdById     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  files           HonorFile[]
}

model HonorFile {
  id          Int      @id @default(autoincrement())
  honorId     Int
  honor       Honor    @relation(fields: [honorId], references: [id], onDelete: Cascade)
  name        String
  data        String?  // base64
  size        Int?
  mimeType    String?
  uploadedBy  Int
  createdAt   DateTime @default(now())
}

model AgreementFile {
  id          Int      @id @default(autoincrement())
  name        String
  url         String?                   // 外部存储 URL（可选）
  data        String?                   // base64 文件内容（直接存 DB）
  size        Int?
  mimeType    String?
  category    String   @default("contract") // contract|supplement|audit|report|other
  year        Int?
  remark      String?
  uploadedBy  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
